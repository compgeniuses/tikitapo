{
  "name": "tikitap0",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "mobile:init": "npx cap init",
    "mobile:add-android": "npx cap add android",
    "mobile:sync": "npx cap sync",
    "mobile:copy": "npx cap copy",
    "mobile:open": "npx cap open android",
    "mobile:build": "npm run build && npx cap sync",
    "android:apk": "npm run mobile:build && cd android && ./gradlew assembleDebug",
    "android:apk-release": "npm run mobile:build && cd android && ./gradlew assembleRelease",
    "android:aab": "npm run mobile:build && cd android && ./gradlew bundleRelease",
    "android:icons": "npx capacitor-assets generate --android",
    "mobile:build-script": "node scripts/build-mobile.js",
    "mobile:apk": "node scripts/build-mobile.js apk",
    "mobile:apk-release": "node scripts/build-mobile.js apk --release",
    "mobile:aab": "node scripts/build-mobile.js aab --release",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@google/genai": "^1.20.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^4.0.18",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.3.0",
    "prettier": "^3.8.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  }
}
